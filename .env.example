# Database — local development
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/survey_dev

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex

# Application
NODE_ENV=development

# Reset email must use a real webhook; the console fallback never prints reset links.
# EMAIL_WEBHOOK_URL=https://your-mail-service.example/send
# EMAIL_WEBHOOK_API_KEY=replace-with-secret
# APP_BASE_URL=https://your-swrtracker-host.example

# Only enable behind an ingress that overwrites X-Real-IP with the client IP.
TRUST_PROXY_IP_HEADERS=false
