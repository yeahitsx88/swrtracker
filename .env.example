# Database — local development
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/survey_dev

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex

# Application
NODE_ENV=development

# Attachment volume (absolute path; mount persistent Railway volume here in production)
ATTACHMENT_STORAGE_ROOT=D:/Programming/SWRTracker/.local/attachments

# Invite links and notification delivery
INVITE_BASE_URL=http://localhost:3000/invites/accept
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.test
