{
  "name": "swrtracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:notifications:once": "tsx src/workers/notification-worker.ts",
    "worker:notifications": "tsx src/workers/notification-worker-loop.ts",
    "test": "node --import tsx --test scripts/run-tests.ts",
    "smoke:ticket": "node --import tsx tests/ticket/ticket-route-smoke.ts",
    "smoke:access": "node --import tsx tests/identity/company-access-smoke.ts",
    "smoke:workflow": "node --import tsx tests/ticket/amelia-workflow-smoke.ts",
    "db:migrate": "tsx --env-file=.env db/migrate.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.1.7",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
